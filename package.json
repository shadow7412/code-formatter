{
  "name": "prettier-mcp-formatter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MCP server that formats code with Prettier and manages approved plugins automatically",
  "main": "dist/server.js",
  "bin": {
    "prettier-mcp-formatter": "dist/server.js",
    "prettier-plugin-cache": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean-cache": "node dist/cli.js clean"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "prettier": "^3.10.1",
    "semver": "^7.8.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/semver": "^7.7.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
